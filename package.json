{
  "name": "jra-bot-web-tools",
  "private": true,
  "description": "CI・リリース補助・フロントエンドの TypeScript（Gradle 外）。docs/LANGUAGE_MIGRATION.md",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "tsc -p tools/tsconfig.json",
    "typecheck": "tsc -p tools/tsconfig.json --noEmit",
    "lint": "biome check tools",
    "format": "biome check --write tools",
    "test": "npm run build && node tools/run-tests.mjs",
    "preflight": "npm run --silent build && node build/tools/src/main.js preflight"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.2",
    "yaml": "2.9.1"
  }
}
