<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows 固有の薄い層（DPAPI・ジョブオブジェクト・JV-Link の COM・レジストリの確認）。Linux でもビルドできるが、呼べるのは Windows だけ（CA1416 で強制）。 -->
  <PropertyGroup>
    <RootNamespace>JraAgent.Windows</RootNamespace>
    <!-- LibraryImport（P/Invoke のソース生成）の生成コードが unsafe を使う。手書きのコードでは unsafe を使わない -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JraAgent.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../JraAgent.Core/JraAgent.Core.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
</Project>
