<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- xunit の命名規則（下線区切りの試験名）は解析規則の対象外にする -->
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/JraAgent.Core/JraAgent.Core.csproj" />
    <ProjectReference Include="../../src/JraAgent.Cli/JraAgent.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../tests/vectors/*.json" LinkBase="vectors" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
