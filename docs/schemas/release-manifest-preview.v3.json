{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/puttun777/jra-bot-web/docs/schemas/release-manifest-preview.v3.json",
  "title": "release-manifest preview (dry run, schema_version 3)",
  "description": "ドライラン成果物（manifest-preview.json）。レジストリに push していないため digest が無い。deployable は常に false で、本番のデプロイに使えない（release-manifest.v1.json には適合しない）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "deployable",
    "blockers",
    "release",
    "git_sha",
    "built_at",
    "contract_version",
    "agent_protocol",
    "images",
    "flyway",
    "required_schema_version",
    "rollback",
    "model_schema_versions",
    "feature_schemas",
    "feature_schema_hash",
    "runtime",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "kind": {
      "const": "release-manifest-preview"
    },
    "deployable": {
      "const": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "本番用 release-manifest.json にできない理由（解消するまで本番に使えない）"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "built_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^0\\.4\\.[0-9]+$"
    },
    "agent_protocol": {
      "const": 1
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard",
        "ingest",
        "bot",
        "db-migration",
        "ml-train"
      ],
      "properties": {
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "built",
            "local_tag",
            "local_image_id",
            "registry_digest",
            "reason"
          ],
          "properties": {
            "built": {
              "type": "boolean"
            },
            "local_tag": {
              "type": [
                "string",
                "null"
              ],
              "description": "ローカルのタグ（レジストリの参照ではない）"
            },
            "local_image_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "docker のローカル image ID。レジストリの manifest digest ではない"
            },
            "registry_digest": {
              "const": null,
              "description": "push していないので常に null（ここに値を入れない）"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ingest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "built",
            "local_tag",
            "local_image_id",
            "registry_digest",
            "reason"
          ],
          "properties": {
            "built": {
              "type": "boolean"
            },
            "local_tag": {
              "type": [
                "string",
                "null"
              ],
              "description": "ローカルのタグ（レジストリの参照ではない）"
            },
            "local_image_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "docker のローカル image ID。レジストリの manifest digest ではない"
            },
            "registry_digest": {
              "const": null,
              "description": "push していないので常に null（ここに値を入れない）"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "bot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "built",
            "local_tag",
            "local_image_id",
            "registry_digest",
            "reason"
          ],
          "properties": {
            "built": {
              "type": "boolean"
            },
            "local_tag": {
              "type": [
                "string",
                "null"
              ],
              "description": "ローカルのタグ（レジストリの参照ではない）"
            },
            "local_image_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "docker のローカル image ID。レジストリの manifest digest ではない"
            },
            "registry_digest": {
              "const": null,
              "description": "push していないので常に null（ここに値を入れない）"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "db-migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "built",
            "local_tag",
            "local_image_id",
            "registry_digest",
            "reason"
          ],
          "properties": {
            "built": {
              "type": "boolean"
            },
            "local_tag": {
              "type": [
                "string",
                "null"
              ],
              "description": "ローカルのタグ（レジストリの参照ではない）"
            },
            "local_image_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "docker のローカル image ID。レジストリの manifest digest ではない"
            },
            "registry_digest": {
              "const": null,
              "description": "push していないので常に null（ここに値を入れない）"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ml-train": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "built",
            "local_tag",
            "local_image_id",
            "registry_digest",
            "reason"
          ],
          "properties": {
            "built": {
              "type": "boolean"
            },
            "local_tag": {
              "type": [
                "string",
                "null"
              ],
              "description": "ローカルのタグ（レジストリの参照ではない）"
            },
            "local_image_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "docker のローカル image ID。レジストリの manifest digest ではない"
            },
            "registry_digest": {
              "const": null,
              "description": "push していないので常に null（ここに値を入れない）"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "flyway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latest_version",
        "baseline"
      ],
      "properties": {
        "latest_version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        },
        "baseline": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)*$"
        }
      }
    },
    "required_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_app_release",
        "verified"
      ],
      "properties": {
        "min_app_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "const": false
        }
      }
    },
    "model_schema_versions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "feature_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration",
        "alpha",
        "market"
      ],
      "description": "特徴量スキーマごとの hash（Kotlin の FeatureSchema が唯一の定義。calibration=40 次元、alpha=35 次元、market=5 次元）。監査用に名前付きで持つ",
      "properties": {
        "calibration": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "alpha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "market": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "feature_schema_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "feature_schemas の正準 JSON（キー順・空白なし・UTF-8）の SHA-256 に sha256: を付けたもの（スキーマの集合全体の単一の値。infra は等価比較にだけ使う）。CONTRACTS §10 の feature_schema_hash の定義"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jdk"
      ],
      "properties": {
        "jdk": {
          "const": "25"
        }
      },
      "description": "実行環境。schema_version 3（CONTRACTS 0.4.17）で python を削除した（ml-train を含む 5 つのイメージはすべて JDK 25。D-257）"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
